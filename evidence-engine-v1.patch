diff --git a/backend/evidence/evidence_summary.py b/backend/evidence/evidence_summary.py
new file mode 100644
index 0000000..4bb441e
--- /dev/null
+++ b/backend/evidence/evidence_summary.py
@@ -0,0 +1,183 @@
+"""
+backend/evidence/evidence_summary.py
+
+Natural-language statements generated FROM the measurements. Every
+statement carries a `basis` object naming the numbers it was built from, so
+the interface (and a reviewer) can trace wording back to data. Nothing here
+is a canned finding: with different measurements the sentences, and the
+decision of which sentences to emit, change.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List
+
+NO_CHANGE_PCT = 1.0  # below this share of pixels, headline reports no substantial pixel change
+
+
+def _pct(x: float) -> str:
+    return f"{x:.1f}%"
+
+
+def change_statements(
+    measurements: Dict[str, Any],
+    concentration: Dict[str, Any],
+    sensitivity: Dict[str, Any],
+    ambiguity: Dict[str, Any],
+    alignment: Dict[str, Any],
+    noise_floor: Dict[str, Any],
+    radiometric: Dict[str, Any],
+    alignment_impact: Dict[str, Any],
+) -> List[Dict[str, Any]]:
+    out: List[Dict[str, Any]] = []
+    t = sensitivity["base_threshold"]
+
+    out.append({
+        "id": "magnitude",
+        "text": (
+            f"{_pct(measurements['changed_pct'])} of pixels ({measurements['changed_pixels']:,} of "
+            f"{measurements['analysed_pixels']:,}) differ by more than {t} gray levels "
+            f"(mean absolute difference over the frame: {measurements['mean_abs_difference']:.1f})."
+        ),
+        "basis": {
+            "changed_pct": measurements["changed_pct"], "changed_pixels": measurements["changed_pixels"],
+            "analysed_pixels": measurements["analysed_pixels"], "base_threshold": t,
+            "mean_abs_difference": measurements["mean_abs_difference"],
+        },
+    })
+
+    pattern = concentration["pattern"]
+    if pattern == "CONCENTRATED":
+        out.append({
+            "id": "distribution",
+            "text": (
+                f"The change is concentrated in {concentration['dominant_cell_phrase']}: grid cell "
+                f"{concentration['dominant_cell']} holds {_pct(concentration['top_cell_share'] * 100)} of all changed pixels."
+            ),
+            "basis": {k: concentration[k] for k in ("pattern", "dominant_cell", "top_cell_share")},
+        })
+    elif pattern == "CLUSTERED":
+        cells = ", ".join(concentration["top_cells"])
+        out.append({
+            "id": "distribution",
+            "text": (
+                f"The change forms several clusters, led by {cells} "
+                f"({_pct(concentration['top3_share'] * 100)} of changed pixels combined); no single region dominates."
+            ),
+            "basis": {k: concentration[k] for k in ("pattern", "top_cells", "top3_share")},
+        })
+    elif pattern == "DISTRIBUTED":
+        out.append({
+            "id": "distribution",
+            "text": (
+                "The change is spread across the frame with no dominant region "
+                f"(the largest cell holds {_pct(concentration['top_cell_share'] * 100)} of changed pixels)."
+            ),
+            "basis": {k: concentration[k] for k in ("pattern", "top_cell_share", "normalised_entropy")},
+        })
+    if pattern != "NONE" and concentration.get("scattered"):
+        out.append({
+            "id": "scatter",
+            "text": (
+                f"Changed pixels are scattered rather than forming compact regions (cohesion {concentration['spatial_cohesion']:.2f}), "
+                "which is typical of noise or fine texture differences rather than discrete surface changes."
+            ),
+            "basis": {"spatial_cohesion": concentration["spatial_cohesion"]},
+        })
+
+    if measurements["changed_pixels"] > 0 or sensitivity["sensitivity_level"] != "NO_CHANGE":
+        ths = ", ".join(str(r["threshold"]) for r in sensitivity["thresholds"])
+        ret = ambiguity["retention_of_base"]
+        out.append({
+            "id": "sensitivity",
+            "text": (
+                (
+                    f"Across thresholds {ths}, the changed area ranges from {_pct(sensitivity['changed_pct_min'])} to "
+                    f"{_pct(sensitivity['changed_pct_max'])}"
+                    if sensitivity["changed_pct_range_pp"] >= 0.05
+                    else f"Across thresholds {ths}, the changed area stays at about {_pct(sensitivity['changed_pct_max'])}"
+                )
+                + f" ({sensitivity['sensitivity_level'].lower().replace('_', ' ')} threshold sensitivity)."
+                + (
+                    f" {ret * 100:.0f}% of the pixels changed at threshold {t} remain changed at the strictest threshold; "
+                    f"{_pct(ambiguity['ambiguous_pct'])} of the frame is threshold-sensitive and should be interpreted cautiously."
+                    if ret is not None else ""
+                )
+            ),
+            "basis": {
+                "changed_pct_min": sensitivity["changed_pct_min"], "changed_pct_max": sensitivity["changed_pct_max"],
+                "sensitivity_level": sensitivity["sensitivity_level"], "retention_of_base": ret,
+                "ambiguous_pct": ambiguity["ambiguous_pct"],
+            },
+        })
+
+    st = alignment["state"]
+    if alignment.get("dx_px") is None:
+        out.append({"id": "alignment", "text": "Alignment could not be estimated: " + " ".join(alignment["reasons"]),
+                    "basis": {"state": st}})
+    else:
+        out.append({
+            "id": "alignment",
+            "text": (
+                f"Alignment diagnostic: {st} (estimated translation dx {alignment['dx_px']:+.1f}px, dy {alignment['dy_px']:+.1f}px; "
+                f"correlation peak {alignment['peak_correlation']:.2f}; valid overlap {alignment['valid_overlap_fraction'] * 100:.0f}%). "
+                "This is a visual translation estimate, not geospatial registration."
+            ),
+            "basis": {k: alignment[k] for k in ("state", "dx_px", "dy_px", "peak_correlation", "valid_overlap_fraction")},
+        })
+    if alignment_impact.get("shift_compensated_changed_pct") is not None:
+        out.append({
+            "id": "alignment_impact",
+            "text": (
+                f"If the estimated shift were compensated, the changed area would be "
+                f"{_pct(alignment_impact['shift_compensated_changed_pct'])} instead of {_pct(measurements['changed_pct'])} "
+                "(what-if diagnostic; the reported measurement is not shift-corrected)."
+            ),
+            "basis": alignment_impact,
+        })
+
+    if radiometric["global_offset_flag"]:
+        out.append({
+            "id": "radiometric_offset",
+            "text": (
+                f"Image B is on average {abs(radiometric['median_signed_difference']):.1f} gray levels "
+                f"{'brighter' if radiometric['median_signed_difference'] > 0 else 'darker'} than image A across the frame. "
+                "A global brightness offset can come from exposure, season or atmosphere rather than surface change; "
+                f"after removing it, the changed area would be {_pct(radiometric['offset_corrected_changed_pct'])}."
+            ),
+            "basis": radiometric,
+        })
+    if noise_floor["threshold_within_noise"]:
+        out.append({
+            "id": "noise_floor",
+            "text": (
+                f"The base threshold ({t}) is only {noise_floor['threshold_over_sigma']:.1f}x the estimated noise of the "
+                f"difference image (sigma {noise_floor['sigma_difference']:.1f}); at least "
+                f"{noise_floor['required_multiple']:.0f}x is recommended, so some detected change may be noise."
+            ),
+            "basis": noise_floor,
+        })
+    return out
+
+
+def change_headline(measurements: Dict[str, Any], concentration: Dict[str, Any]) -> str:
+    """The measured headline only. The pipeline appends the reliability caveat."""
+    pct = measurements["changed_pct"]
+    t = measurements["base_threshold"]
+    if pct < NO_CHANGE_PCT:
+        return f"No substantial pixel-level change was detected: {_pct(pct)} of pixels differ by more than {t} gray levels."
+    where = (
+        concentration["dominant_cell_phrase"] if concentration["pattern"] == "CONCENTRATED" else concentration["centroid_phrase"]
+    )
+    return (
+        f"Pixel-level change was detected across {_pct(pct)} of the frame, "
+        f"{'concentrated in' if concentration['pattern'] == 'CONCENTRATED' else 'centred on'} {where}."
+    )
+
+
+def reliability_suffix(level: str, concerns: List[str]) -> str:
+    if level == "UNSUPPORTED":
+        return " This result should NOT be relied on: " + (concerns[0].rstrip(".") if concerns else "diagnostics failed") + "."
+    if level == "SUPPORTED":
+        return ""
+    return f" Evidence level {level}: " + "; ".join(c.rstrip(".") for c in concerns[:2]) + "."
diff --git a/backend/evidence/region_analysis.py b/backend/evidence/region_analysis.py
new file mode 100644
index 0000000..c516640
--- /dev/null
+++ b/backend/evidence/region_analysis.py
@@ -0,0 +1,90 @@
+"""
+backend/evidence/region_analysis.py
+
+How is the change distributed? Concentrated in one place, clustered,
+spread evenly, or scattered noise?
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any, Dict, List, Optional
+
+import numpy as np
+
+from backend import config
+from backend.imgops import cohesion
+
+
+def location_phrase(cx: float, cy: float) -> str:
+    """Normalised centroid (0..1, origin top-left) -> words about the image frame."""
+    v = "upper" if cy < 1 / 3 else "middle" if cy < 2 / 3 else "lower"
+    h = "left" if cx < 1 / 3 else "center" if cx < 2 / 3 else "right"
+    if v == "middle" and h == "center":
+        return "the center of the frame"
+    if v == "middle":
+        return f"the {h} side of the frame"
+    if h == "center":
+        return f"the {v} part of the frame"
+    return f"the {v}-{h} of the frame"
+
+
+def concentration(
+    cells: List[Dict[str, Any]],
+    base_mask: np.ndarray,
+    cfg: config.ChangeParams = config.CHANGE,
+) -> Dict[str, Any]:
+    total = int(base_mask.sum())
+    n_cells = len(cells)
+    if total == 0:
+        return {
+            "pattern": "NONE", "total_changed_pixels": 0, "dominant_cell": None, "top_cells": [],
+            "top_cell_share": 0.0, "top3_share": 0.0, "normalised_entropy": None, "gini": None,
+            "spatial_cohesion": None, "scattered": False, "centroid_norm": None, "centroid_phrase": None,
+        }
+    counts = np.array([c["changed_pixel_count"] for c in cells], dtype=np.float64)
+    shares = counts / counts.sum()
+    order = np.argsort(-shares)
+    top1 = float(shares[order[0]])
+    top3 = float(shares[order[:3]].sum())
+    nz = shares[shares > 0]
+    entropy = float(-(nz * np.log(nz)).sum())
+    h_norm = entropy / math.log(n_cells) if n_cells > 1 else 0.0
+    srt = np.sort(shares)
+    idx = np.arange(1, n_cells + 1)
+    gini = float((2 * (idx * srt).sum() / (n_cells * srt.sum())) - (n_cells + 1) / n_cells)
+
+    coh = cohesion(base_mask)
+    h, w = base_mask.shape
+    ys, xs = np.nonzero(base_mask)
+    cx, cy = float(xs.mean() / w), float(ys.mean() / h)
+
+    pattern = (
+        "CONCENTRATED" if top1 >= cfg.concentrated_top_cell_share
+        else "DISTRIBUTED" if h_norm >= cfg.distributed_entropy
+        else "CLUSTERED"
+    )
+    dominant = cells[int(order[0])]
+    return {
+        "pattern": pattern,
+        "total_changed_pixels": total,
+        "dominant_cell": dominant["region_id"],
+        "dominant_cell_phrase": location_phrase(
+            (dominant["bbox_norm"][0] + dominant["bbox_norm"][2]) / 2,
+            (dominant["bbox_norm"][1] + dominant["bbox_norm"][3]) / 2,
+        ),
+        "top_cells": [cells[int(i)]["region_id"] for i in order[:3] if shares[int(i)] > 0],
+        "top_cell_share": round(top1, 4),
+        "top3_share": round(top3, 4),
+        "normalised_entropy": round(h_norm, 4),
+        "gini": round(gini, 4),
+        "spatial_cohesion": round(coh, 4),
+        "scattered": bool(coh < cfg.cohesion_scattered),
+        "centroid_norm": [round(cx, 4), round(cy, 4)],
+        "centroid_phrase": location_phrase(cx, cy),
+        "rules": (
+            f"CONCENTRATED if the top cell holds >= {cfg.concentrated_top_cell_share:.0%} of changed pixels; "
+            f"DISTRIBUTED if normalised entropy >= {cfg.distributed_entropy}; otherwise CLUSTERED. "
+            f"'Scattered' if cohesion < {cfg.cohesion_scattered} (share of changed pixels with >= 3 changed neighbours)."
+        ),
+    }
diff --git a/backend/evidence/spatial_grid.py b/backend/evidence/spatial_grid.py
new file mode 100644
index 0000000..67da021
--- /dev/null
+++ b/backend/evidence/spatial_grid.py
@@ -0,0 +1,149 @@
+"""
+backend/evidence/spatial_grid.py
+
+Per-cell spatial evidence for a change analysis. Every number in a cell
+record is measured from the actual difference array; nothing is templated
+or hard-coded.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List
+
+import numpy as np
+
+from backend import config
+from backend.imgops import laplacian, to_gray
+
+EVIDENCE_STRENGTH_RULE = (
+    "NONE if change% < {min:.0f}. Otherwise STRONG if change% >= {strong:.0f} and retention at the strictest "
+    "threshold >= {sret:.2f}; MODERATE if retention >= {mret:.2f}; else WEAK. "
+    "A local quality warning demotes the level by one step."
+)
+
+
+def strength_rule_text(cfg: config.ChangeParams = config.CHANGE) -> str:
+    return EVIDENCE_STRENGTH_RULE.format(
+        min=cfg.min_cell_change_pct, strong=cfg.strong_cell_change_pct,
+        sret=cfg.strong_retention, mret=cfg.moderate_retention,
+    )
+
+
+def grid_edges(size: int, n: int) -> np.ndarray:
+    return np.linspace(0, size, n + 1).round().astype(int)
+
+
+def _grade(change_pct: float, retention, quality_warning: bool, cfg: config.ChangeParams) -> str:
+    if change_pct < cfg.min_cell_change_pct:
+        return "NONE"
+    ret = 0.0 if retention is None else retention
+    if change_pct >= cfg.strong_cell_change_pct and ret >= cfg.strong_retention:
+        level = "STRONG"
+    elif ret >= cfg.moderate_retention:
+        level = "MODERATE"
+    else:
+        level = "WEAK"
+    if quality_warning:
+        level = {"STRONG": "MODERATE", "MODERATE": "WEAK", "WEAK": "WEAK"}[level]
+    return level
+
+
+def build_spatial_grid(
+    pixels_a: np.ndarray,
+    pixels_b: np.ndarray,
+    diff: np.ndarray,
+    base_mask: np.ndarray,
+    stable: np.ndarray,
+    ambiguous: np.ndarray,
+    grid_size: int,
+    base_threshold: int,
+    strict_threshold: int,
+    cfg: config.ChangeParams = config.CHANGE,
+    qt: config.QualityThresholds = config.QUALITY,
+) -> Dict[str, Any]:
+    h, w = diff.shape
+    gray_a, gray_b = to_gray(pixels_a), to_gray(pixels_b)
+    lap_a, lap_b = laplacian(gray_a), laplacian(gray_b)
+    ys, xs = grid_edges(h, grid_size), grid_edges(w, grid_size)
+    total_changed = int(base_mask.sum())
+
+    cells: List[Dict[str, Any]] = []
+    for r in range(grid_size):
+        for c in range(grid_size):
+            y0, y1, x0, x1 = int(ys[r]), int(ys[r + 1]), int(xs[c]), int(xs[c + 1])
+            area = (y1 - y0) * (x1 - x0)
+            d = diff[y0:y1, x0:x1]
+            changed = int(base_mask[y0:y1, x0:x1].sum())
+            stable_n = int(stable[y0:y1, x0:x1].sum())
+            amb_n = int(ambiguous[y0:y1, x0:x1].sum())
+            pct = changed / area * 100.0 if area else 0.0
+            retention = None if changed == 0 else stable_n / changed
+
+            ga, gb = gray_a[y0:y1, x0:x1], gray_b[y0:y1, x0:x1]
+            clip_a = float(((ga <= qt.clip_low_level) | (ga >= qt.clip_high_level)).mean() * 100.0)
+            clip_b = float(((gb <= qt.clip_low_level) | (gb >= qt.clip_high_level)).mean() * 100.0)
+            std_a, std_b = float(ga.std()), float(gb.std())
+            la = lap_a[max(0, y0 - 1):max(0, y1 - 1), max(0, x0 - 1):max(0, x1 - 1)]
+            lb = lap_b[max(0, y0 - 1):max(0, y1 - 1), max(0, x0 - 1):max(0, x1 - 1)]
+            sharp_a = float(la.var()) if la.size else 0.0
+            sharp_b = float(lb.var()) if lb.size else 0.0
+
+            reasons: List[str] = []
+            if max(clip_a, clip_b) >= qt.clip_high_pct:
+                reasons.append(f"saturation: {max(clip_a, clip_b):.0f}% of pixels clipped in at least one image")
+            if max(std_a, std_b) < config.ALIGNMENT.min_texture_std and pct > 0:
+                reasons.append("featureless in both images: the difference is a brightness shift of a uniform area and may reflect exposure rather than surface")
+            warning = bool(reasons)
+            strength = _grade(pct, retention, warning, cfg)
+
+            if strength == "NONE":
+                interp = (
+                    f"No pixel-difference evidence in this region ({pct:.1f}% of pixels exceed threshold {base_threshold})."
+                )
+            else:
+                interp = (
+                    f"{'Elevated' if strength in ('STRONG', 'MODERATE') else 'Weak'} pixel difference in this region: "
+                    f"{pct:.1f}% of pixels exceed threshold {base_threshold} (mean difference {float(d.mean()):.1f} gray levels); "
+                    + (
+                        f"{retention * 100:.0f}% of the changed pixels persist at threshold {strict_threshold}."
+                        if retention is not None else "no changed pixels persist at the strictest threshold."
+                    )
+                )
+            if warning:
+                interp += " Quality caution: " + "; ".join(reasons) + "."
+
+            cells.append({
+                "region_id": f"grid_{r * grid_size + c}",
+                "row": r,
+                "col": c,
+                "bbox_px": [x0, y0, x1, y1],
+                "bbox_norm": [round(x0 / w, 5), round(y0 / h, 5), round(x1 / w, 5), round(y1 / h, 5)],
+                "analysed_pixel_count": int(area),
+                "changed_pixel_count": changed,
+                "change_percentage": round(pct, 3),
+                "share_of_total_change_pct": round(changed / total_changed * 100.0, 3) if total_changed else 0.0,
+                "mean_abs_difference": round(float(d.mean()), 3),
+                "p95_abs_difference": round(float(np.percentile(d, 95)), 3) if area else 0.0,
+                "stable_changed_pixels": stable_n,
+                "ambiguous_pixels": amb_n,
+                "retention_at_strictest": None if retention is None else round(retention, 4),
+                "local_quality": {
+                    "clipped_pct_a": round(clip_a, 2), "clipped_pct_b": round(clip_b, 2),
+                    "contrast_std_a": round(std_a, 2), "contrast_std_b": round(std_b, 2),
+                    "sharpness_a": round(sharp_a, 2), "sharpness_b": round(sharp_b, 2),
+                },
+                "quality_warning": warning,
+                "quality_warning_reasons": reasons,
+                "evidence_type": "pixel_intensity_difference",
+                "evidence_strength": strength,
+                "interpretation": interp,
+            })
+
+    return {
+        "grid_size": grid_size,
+        "cell_count": len(cells),
+        "base_threshold": base_threshold,
+        "strictest_threshold": strict_threshold,
+        "evidence_strength_rule": strength_rule_text(cfg),
+        "cells": cells,
+    }
