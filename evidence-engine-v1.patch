+@pytest.mark.parametrize("n", [2, 3, 4, 7, 12])
+def test_grid_partitions_the_frame_for_any_size(n):
+    a = flat(100, (157, 131))      # not divisible by n
+    b = a.copy(); b[5:60, 7:90] = 200
