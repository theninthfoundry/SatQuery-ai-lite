+.mono { font-family: var(--mono); }
+.muted { color: var(--text-muted); } .faint { color: var(--text-faint); }
+
+header { border-bottom: 1px solid var(--border-soft); padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
+.brand { display: flex; align-items: center; gap: 12px; }
+.mark { width: 34px; height: 34px; border: 1px solid var(--sar); border-radius: 8px; display: grid; place-items: center; font: 600 13px var(--mono); color: var(--sar); }
+.brand h1 { font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
+.brand p { font-size: 12px; color: var(--text-muted); }
+.hdr-right { display: flex; align-items: center; gap: 10px; font: 12px var(--mono); color: var(--text-muted); }
+.pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border: 1px solid var(--border); border-radius: 100px; font: 500 11.5px var(--mono); white-space: nowrap; }
+.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-faint); }
+.pill.ok .dot { background: var(--ok); } .pill.bad .dot { background: var(--change); }
+.navtabs { display: flex; gap: 2px; }
+.navtabs button { background: none; border: 0; padding: 6px 12px; border-radius: var(--r-sm); color: var(--text-muted); cursor: pointer; }
+.navtabs button.active { background: var(--panel-2); color: var(--text); }
+
+main { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 20px; padding: 20px 24px 60px; max-width: 1500px; margin: 0 auto; align-items: start; }
+@media (max-width: 960px) { main { grid-template-columns: 1fr; } }
+
+.card { background: var(--panel); border: 1px solid var(--border-soft); border-radius: var(--r-md); padding: 16px; }
+.card + .card { margin-top: 14px; }
+.card h2 { font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); margin-bottom: 12px; }
+.card h3 { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
+.side { position: sticky; top: 14px; }
+@media (max-width: 960px) { .side { position: static; } }
+
+.seg { display: grid; gap: 6px; margin-bottom: 14px; }
+.seg button { text-align: left; padding: 9px 12px; background: var(--bg-alt); border: 1px solid var(--border-soft); border-radius: var(--r-sm); color: var(--text-muted); cursor: pointer; }
+.seg button.active { border-color: var(--sar); color: var(--text); }
+.seg small { display: block; color: var(--text-faint); font-size: 11.5px; }
+
+.slot { margin-bottom: 12px; }
+.slot-label { font-size: 12.5px; font-weight: 500; }
+.slot-hint { font-size: 11.5px; color: var(--text-faint); margin-bottom: 4px; }
+.drop { display: flex; gap: 10px; align-items: center; padding: 8px; border: 1px dashed var(--border); border-radius: var(--r-sm); background: var(--bg-alt); cursor: pointer; min-height: 56px; }
+.drop:hover, .drop.over { border-color: var(--sar); }
+.drop.filled { border-style: solid; }
+.drop input { display: none; }
+.drop img, .drop .ph { width: 42px; height: 42px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border); flex: none; }
+.drop .ph { display: grid; place-items: center; font: 10px var(--mono); color: var(--text-faint); }
+.drop .meta { min-width: 0; font-size: 12px; }
+.drop .meta b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
+.slot-err { color: var(--change); font-size: 12px; margin-top: 4px; }
+
+textarea, select, input[type=number], input[type=text] { width: 100%; background: var(--bg-alt); border: 1px solid var(--border-soft); border-radius: var(--r-sm); padding: 9px 11px; }
+textarea { resize: vertical; min-height: 72px; }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
+.chip { background: none; border: 1px solid var(--border-soft); color: var(--text-muted); font-size: 11.5px; padding: 4px 9px; border-radius: 100px; cursor: pointer; text-align: left; }
+.chip:hover { color: var(--text); border-color: var(--sar); }
+details.opts { margin-top: 12px; border-top: 1px solid var(--border-soft); padding-top: 10px; }
+details.opts summary { cursor: pointer; color: var(--text-muted); font-size: 12.5px; }
+.optgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
+.optgrid label { font-size: 11.5px; color: var(--text-muted); display: block; margin-bottom: 3px; }
+.optgrid .full { grid-column: 1 / -1; }
+.check { display: flex; gap: 8px; align-items: flex-start; font-size: 12px; color: var(--text-muted); margin-top: 10px; }
+.check input { margin-top: 3px; }
+.btnrow { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; margin-top: 14px; }
+.btn { padding: 10px 14px; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--panel-2); cursor: pointer; font-weight: 500; }
+.btn:hover:not(:disabled) { background: var(--panel-3); }
+.btn.primary { background: var(--text); color: var(--bg); border-color: var(--text); }
+.btn.primary:hover:not(:disabled) { background: #e4e4e7; }
+.btn:disabled { opacity: .45; cursor: not-allowed; }
+.btn.small { padding: 5px 10px; font-size: 12px; }
+
+.banner { border: 1px solid var(--border); border-radius: var(--r-md); padding: 12px 14px; margin-bottom: 14px; background: var(--panel); }
+.banner.err { border-color: rgba(239,68,68,.6); background: rgba(239,68,68,.07); }
+.banner.warn { border-color: rgba(245,158,11,.55); background: rgba(245,158,11,.06); }
+.banner.info { border-color: rgba(94,200,216,.45); background: rgba(94,200,216,.06); }
+.banner h3 { font-size: 13.5px; margin-bottom: 4px; }
+
+.empty { border: 1px dashed var(--border); border-radius: var(--r-lg); padding: 48px 24px; text-align: center; color: var(--text-muted); }
+.empty h2 { font-size: 17px; color: var(--text); margin-bottom: 8px; }
+.empty ul { text-align: left; display: inline-block; margin-top: 14px; font-size: 13px; }
+
+.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border-soft); margin-bottom: 16px; overflow-x: auto; }
+.tabs button { background: none; border: 0; border-bottom: 2px solid transparent; padding: 9px 14px; color: var(--text-muted); cursor: pointer; white-space: nowrap; }
+.tabs button.active { color: var(--text); border-color: var(--sar); }
+
+.answer { font-size: 16.5px; line-height: 1.55; letter-spacing: -.005em; }
+.chiprow { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }
